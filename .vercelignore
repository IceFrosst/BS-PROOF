# .git must NOT be ignored: the project's Ignored Build Step runs
# `git diff HEAD^ HEAD` to decide whether a push touches the dashboard, and
# removing .git made that command error in every deployment (2026-08-11:
# every push to main -> Error in 2s -> a failure email). .github stays ignored.
.github
.env*
.next
node_modules
out
__pycache__
*.py[cod]
*.sqlite
*.sqlite-*
reports/archive
docs/history
pipeline_v1.excalidraw
pipeline_v2_demo.excalidraw

# Playwright output. Gitignored, but .vercelignore is a SEPARATE list and the
# CLI uploads the working tree, not the git index -- so a local `npm run
# test:e2e` put 246 MB of videos and traces into the deploy upload and every
# `vercel deploy` died with "Upload aborted" partway through (2026-08-24).
test-results
playwright-report
