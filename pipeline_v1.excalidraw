   "index": "b0177"
  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785777351988,
   "link": null,
   "locked": false,
   "id": "u4DA4D2SI78wEQUG33-GH",
   "type": "text",
   "x": 2114,
   "y": 2412,
   "width": 392.70000000000005,
   "height": 227.5,
   "text": "OPEN / UNRESOLVED\n--------------------------\n- k is a guess until Tier-3 calibration exists\n- transfer factors are guesses, same\n- dose_band shifts when new trials land ->\n  band_version must invalidate cached ECUs\n- outcome vocabulary mapping is the highest-risk\n  unsolved piece; force-map or DISCARD, never guess\n- Epistemonikos supplement coverage: UNKNOWN\n- blinding integrity is binary in the RoB proxy but\n  many supplement placebos are detectable\n  (niacin flush, caffeine, creatine weight gain)\n  -> systematically over-credits blinding, v2 fix",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "z5j6uTV4Ko8a2PyIRfE_S",
   "originalText": "OPEN / UNRESOLVED\n--------------------------\n- k is a guess until Tier-3 calibration exists\n- transfer factors are guesses, same\n- dose_band shifts when new trials land ->\n  band_version must invalidate cached ECUs\n- outcome vocabulary mapping is the highest-risk\n  unsolved piece; force-map or DISCARD, never guess\n- Epistemonikos supplement coverage: UNKNOWN\n- blinding integrity is binary in the RoB proxy but\n  many supplement placebos are detectable\n  (niacin flush, caffeine, creatine weight gain)\n  -> systematically over-credits blinding, v2 fix",
   "autoResize": false,
   "lineHeight": 1.25,
   "seed": 1643665388,
   "version": 1,
   "versionNonce": 1883203205,
   "index": "b0178"
