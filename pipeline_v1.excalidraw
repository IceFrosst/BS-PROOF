  },
  {
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785777351988,
   "link": null,
   "locked": false,
   "id": "nLcY68wkDJzaykww98sL7",
   "type": "text",
   "x": 2114,
   "y": 1312,
   "width": 469.70000000000005,
   "height": 402.5,
   "text": "CALIBRATION  (no scientist required for v1)\n---------------------------------------------------\nTIER 1  EFSA health claims register\n  EU-official, machine readable, hundreds of rows.\n  CAVEAT: EFSA is EXTREMELY strict - it rejected the\n  vast majority of claims. Use it as a ONE-SIDED\n  constraint: EFSA-authorised MUST come out positive.\n  EFSA-rejected does NOT have to come out negative.\n\nTIER 2  28 face-validity anchors  -> ANCHORS.md\n  14 span the 7 score bands\n  3  form-sensitivity pairs   (D2 vs D3, MgO vs glycinate)\n  2  dose-sensitivity pairs   (one is a FALSE-POSITIVE check)\n  4  population-flip pairs    (deficient vs replete)\n  2  dedup stress cases       (omega-3 CV, vitamin D)\n  1  harm tier                (beta-carotene in smokers)\n\nTIER 3  the scientist, ~25 nuanced ECUs, half a day\n  REQUIRED for k and the transfer constants.\n  Tiers 1-2 validate SIGN and BAND only.\n\nScore by BAND MEMBERSHIP, not numeric distance.\nReport PER-COMPONENT error, not aggregate accuracy.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": "DPmWKFYvCdFUp3rLevELp",
   "originalText": "CALIBRATION  (no scientist required for v1)\n---------------------------------------------------\nTIER 1  EFSA health claims register\n  EU-official, machine readable, hundreds of rows.\n  CAVEAT: EFSA is EXTREMELY strict - it rejected the\n  vast majority of claims. Use it as a ONE-SIDED\n  constraint: EFSA-authorised MUST come out positive.\n  EFSA-rejected does NOT have to come out negative.\n\nTIER 2  28 face-validity anchors  -> ANCHORS.md\n  14 span the 7 score bands\n  3  form-sensitivity pairs   (D2 vs D3, MgO vs glycinate)\n  2  dose-sensitivity pairs   (one is a FALSE-POSITIVE check)\n  4  population-flip pairs    (deficient vs replete)\n  2  dedup stress cases       (omega-3 CV, vitamin D)\n  1  harm tier                (beta-carotene in smokers)\n\nTIER 3  the scientist, ~25 nuanced ECUs, half a day\n  REQUIRED for k and the transfer constants.\n  Tiers 1-2 validate SIGN and BAND only.\n\nScore by BAND MEMBERSHIP, not numeric distance.\nReport PER-COMPONENT error, not aggregate accuracy.",
   "autoResize": false,
   "lineHeight": 1.25,
   "seed": 924879669,
   "version": 1,
   "versionNonce": 1186265123,
   "index": "b0174"
  },
