# Copy to .env.local and fill in. NEVER commit the filled copy -- .gitignore
# excludes .env*, and this example is the one deliberate exception.
#
# None of this is needed to read the dashboard. Every run page, score and arc
# renders from the artifacts committed under reports/runs/, so a clone can
# `npm install && npm run build` and see everything with no key at all.
#
# A key is needed for ONE feature: reading a supplement label from a photo
# (POST /api/analyze-label). Without it that route returns
# `analyzer_unavailable` (503) and the rest of the site is unaffected.

# --- the vision read (label photo -> ingredient, form, printed dose) ---------

# Preferred key variable. Takes precedence over GEMINI_API_KEY.
VISION_API_KEY=

# Legacy name, still read as a fallback. Note the name is historical: it is
# whatever key the configured provider expects, not necessarily a Google one.
GEMINI_API_KEY=

# Provider is CONFIG, not code -- any OpenAI-compatible chat-completions
# endpoint works, and the same prompts/label.md is sent either way.
#
# Leave both blank for the default: the Gemini free tier (a key from Google AI
# Studio, no card, ~1,500 image reads/day). Measured 2026-08-24: reliable when
# it is not busy, but it returned 503 "high demand" on roughly half of the
# attempts that afternoon.
#
# For DeepSeek instead (measured 3/3 successful the same evening, slower at
# 9-16 s per read):
#   VISION_API_URL=https://api.deepseek.com/chat/completions
#   LABEL_MODEL=deepseek-v4-flash-vision-exp
VISION_API_URL=
LABEL_MODEL=

# --- kill switch ------------------------------------------------------------

# Set to 0 to disable label reading even when a key is present. Anything else
# (or unset) leaves it enabled. Used to force the demo to answer only from
# full-pipeline scored runs.
LABEL_ANALYZER_ENABLED=
