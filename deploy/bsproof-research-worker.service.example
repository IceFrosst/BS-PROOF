# systemd USER unit for the BS-PROOF mainPC research worker. EXAMPLE ONLY: it is not
# installed anywhere. Install path: ~/.config/systemd/user/bsproof-research-worker.service
#
# NOTE (2026-10-05, local time): `systemctl --user` was working on the mainPC (user manager running, Linger=yes), so this user unit is the install path.
# CAUTION: `systemd-analyze --user verify` re-binds $XDG_RUNTIME_DIR/systemd/private; run against the REAL runtime dir it orphans the live user
# manager's socket (`systemctl --user` then fails with "Failed to connect to bus"). Verify a copy with a THROWAWAY runtime dir only:
#   XDG_RUNTIME_DIR=$(mktemp -d) systemd-analyze --user verify /tmp/bsproof-research-worker.service
#
# Outbound-only: the worker opens no listening socket; it POSTs to the website over
# HTTPS and runs the already-logged-in Claude CLI as a child (subscription login,
# no API key). It runs from the isolated, versioned runtime under
# ~/.local/share/bsproof-research-worker, never from an app checkout.
#
# The token lives ONLY in the 0600 EnvironmentFile below; never put it in this file.
[Unit]
Description=BS-PROOF research worker (outbound-only, Claude subscription)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bsproof-research-worker/current
EnvironmentFile=%h/.config/bsproof-research-worker/worker.env
# The Claude CLI is a native ELF binary and does not need node. The nvm node dir
# (v22.23.2) is kept on PATH only in case a CLI subprocess needs it.
Environment=PATH=%h/.local/bin:/home/icefrost/.nvm/versions/node/v22.23.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=BS_PROOF_CLAUDE_BIN=/home/icefrost/.local/bin/claude
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Subscription login only: never let an API credential reach the CLI (same as the reviewed system unit).
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_BASE_URL
ExecStart=%h/.local/share/bsproof-research-worker/current/venv/bin/python %h/.local/share/bsproof-research-worker/current/scripts/pc_research_worker.py run
Restart=on-failure
RestartSec=30
# SIGTERM cancels a running research call; the lease is left to expire (no result is
# sent for a run that was cut off). Give it time to kill the CLI process group.
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
