# systemd SYSTEM unit for the BS-PROOF mainPC research worker, running as User=icefrost.
# EXAMPLE ONLY: it is not installed anywhere and nothing here starts a service.
# Owner-installed path: /etc/systemd/system/bsproof-research-worker.service
#
# Why a system unit: on the mainPC (WSL2) the user manager's private socket is orphaned
# and there is no user D-Bus, so `systemctl --user` cannot manage a user unit, and
# restarting user@1000 / dbus / WSL is NOT an acceptable way to fix that. A system unit
# does not touch the user manager, session or WSL. Installing it needs sudo (the
# owner's password; an agent must never receive or store it).
#
# Outbound-only: the worker opens no listening socket; it POSTs to the website over
# HTTPS and runs the already-logged-in Claude CLI (subscription login, no API key) as
# a child. User=icefrost/HOME=/home/icefrost is REQUIRED so the CLI can reach its own
# 0600 ~/.claude credentials; root or DynamicUser cannot. Paths are absolute because
# `%h` in a system unit is /root, not the User's home.
#
# The token lives ONLY in the 0600 EnvironmentFile below; never put it in this file.
# Do not add ProtectHome: the CLI writes ~/.claude and the worker writes its data dir.
[Unit]
Description=BS-PROOF research worker (outbound-only, Claude subscription)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=icefrost
Group=icefrost
WorkingDirectory=/home/icefrost/.local/share/bsproof-research-worker/current
EnvironmentFile=/home/icefrost/.config/bsproof-research-worker/worker.env
Environment=HOME=/home/icefrost
# The Claude CLI is a native ELF binary and does not need node. The nvm node dir
# (v22.23.2) is kept on PATH only in case a CLI subprocess needs it.
Environment=PATH=/home/icefrost/.local/bin:/home/icefrost/.nvm/versions/node/v22.23.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=BS_PROOF_CLAUDE_BIN=/home/icefrost/.local/bin/claude
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Subscription login only: never let an API credential reach the CLI.
UnsetEnvironment=ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_BASE_URL
ExecStart=/home/icefrost/.local/share/bsproof-research-worker/current/venv/bin/python /home/icefrost/.local/share/bsproof-research-worker/current/scripts/pc_research_worker.py run
Restart=on-failure
RestartSec=30
# SIGTERM cancels a running research call; the lease is left to expire (no result is
# sent for a run that was cut off). Give it time to kill the CLI process group.
KillMode=control-group
TimeoutStopSec=60
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=multi-user.target
