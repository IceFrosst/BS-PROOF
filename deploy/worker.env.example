# ~/.config/bsproof-research-worker/worker.env  -- MUST be mode 0600 (the worker refuses otherwise).
# Copy this file, fill in the token, then: chmod 600 worker.env
# Never commit the real file. The token is issued by the website owner (Vercel env
# BS_PROOF_RESEARCH_WORKER_TOKEN holds the matching secret); it is the ONLY secret here.
BS_PROOF_RESEARCH_WORKER_TOKEN=
# Canonical https ORIGIN only (no path). Example shape: https://<canonical-host>
BS_PROOF_RESEARCH_API_BASE=
# --- optional timing knobs (seconds). Configuration, not caps on a research run. ---
# BS_PROOF_RESEARCH_POLL_SECONDS=20          # idle wait between claims
# BS_PROOF_RESEARCH_HEARTBEAT_SECONDS=30     # lease renewal interval; keep well under the server lease
# BS_PROOF_RESEARCH_QUOTA_COOLDOWN_SECONDS=900   # pause after a subscription quota/rate-limit failure
# BS_PROOF_RESEARCH_BACKOFF_MAX_SECONDS=300  # ceiling for network/claim backoff delay
# BS_PROOF_RESEARCH_RETRY_BASE_SECONDS=2     # first delivery retry delay (doubles, jittered)
# BS_PROOF_RESEARCH_HTTP_TIMEOUT_SECONDS=60  # per HTTP request, not per job
# BS_PROOF_RESEARCH_DATA_DIR=%h/.local/share/bsproof-research-worker/data
# BS_PROOF_CLAUDE_BIN=/home/icefrost/.local/bin/claude
