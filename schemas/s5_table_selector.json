{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BS-PROOF S5 table-candidate selector",
  "type": "object",
  "required": [
    "selected_candidate_index",
    "n_ingredient",
    "n_control",
    "mean_ingredient",
    "mean_control",
    "sd_ingredient",
    "sd_control",
    "estimand",
    "timepoint",
    "design_kind",
    "table_provenance",
    "refusal_reason"
  ],
  "additionalProperties": false,
  "properties": {
    "selected_candidate_index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100000
    },
    "n_ingredient": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000000
    },
    "n_control": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 1000000
    },
    "mean_ingredient": {
      "type": [
        "number",
        "null"
      ],
      "maximum": 1000000000000,
      "minimum": -1000000000000
    },
    "mean_control": {
      "type": [
        "number",
        "null"
      ],
      "maximum": 1000000000000,
      "minimum": -1000000000000
    },
    "sd_ingredient": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "maximum": 1000000000000
    },
    "sd_control": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0,
      "maximum": 1000000000000
    },
    "estimand": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "endpoint",
        "change_from_baseline",
        null
      ]
    },
    "timepoint": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "design_kind": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "parallel",
        "crossover",
        "cluster",
        "other",
        null
      ]
    },
    "table_provenance": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "caption",
        "row",
        "column"
      ],
      "properties": {
        "caption": {
          "type": "string",
          "maxLength": 500
        },
        "row": {
          "type": "string",
          "maxLength": 500
        },
        "column": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "refusal_reason": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 500
    }
  },
  "description": "Select-XOR-refuse is enforced deterministically in workers._shadow_validate_selection (refusal => every selection field null; selection => refusal_reason null, all fields typed and candidate-matched). It was previously a top-level oneOf here, but the Anthropic API rejects top-level oneOf/allOf/anyOf in tool input schemas (400), which silently killed EVERY S5T call. Do not re-add compositional keywords at the top level."
}