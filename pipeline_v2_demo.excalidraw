  },
  {
   "id": "VZ80yXOP9l6yg0g8EuRFM",
   "type": "text",
   "x": 1514,
   "y": 980.5,
   "width": 470.4,
   "height": 192.5,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1988176313,
   "version": 1,
   "versionNonce": 1354778728,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785777351988,
   "link": null,
   "locked": false,
   "index": "b0124",
   "text": "WHY 0-100 DOESN'T LIE\n---------------------\n  1 weak trial, positive     ->   3   evidence arc EMPTY\n  20 solid null trials       ->  15   evidence arc FULL\n\nBoth are low numbers. The evidence arc is what tells\n\"useless\" apart from \"unstudied\" -- the number alone\nnever could, which is the whole reason the ring is\nnot decoration.\n\n  50 = no effect either way, NOT \"half good\".",
   "originalText": "WHY 0-100 DOESN'T LIE\n---------------------\n  1 weak trial, positive     ->   3   evidence arc EMPTY\n  20 solid null trials       ->  15   evidence arc FULL\n\nBoth are low numbers. The evidence arc is what tells\n\"useless\" apart from \"unstudied\" -- the number alone\nnever could, which is the whole reason the ring is\nnot decoration.\n\n  50 = no effect either way, NOT \"half good\".",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
