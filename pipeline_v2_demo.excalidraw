  },
  {
   "id": "XZXMqh3QWRi1ZL6670Px8",
   "type": "text",
   "x": 1514,
   "y": 339.5,
   "width": 428.4,
   "height": 280.0,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 2145038423,
   "version": 1,
   "versionNonce": 1135888857,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785777351988,
   "link": null,
   "locked": false,
   "index": "b0120",
   "text": "WEIGHT = QUALITY ONLY  (w_study)\n--------------------------------\n  design: RCT 1.00   non-rand CT 0.55   cohort 0.30\n  RoB low                 1.00\n  RoB some concerns       0.60\n  RoB high                0.25\n  independent funding     1.00\n  brand funded            0.60\n  full text               1.00\n  SR table only           0.85\n  abstract only           0.55\n  size:  min(1, log10(n) / 2)\n\nFORM and DOSE factors still exist (1.00 exact /\n0.50 salt family / 0.15 different) but they\nfeed the ARCS now, not the weight.",
   "originalText": "WEIGHT = QUALITY ONLY  (w_study)\n--------------------------------\n  design: RCT 1.00   non-rand CT 0.55   cohort 0.30\n  RoB low                 1.00\n  RoB some concerns       0.60\n  RoB high                0.25\n  independent funding     1.00\n  brand funded            0.60\n  full text               1.00\n  SR table only           0.85\n  abstract only           0.55\n  size:  min(1, log10(n) / 2)\n\nFORM and DOSE factors still exist (1.00 exact /\n0.50 salt family / 0.15 different) but they\nfeed the ARCS now, not the weight.",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "XpWSf6YrHtYMy-mcIbrld",
   "type": "rectangle",
   "x": 1500,
   "y": 663.5,
   "width": 560,
   "height": 273.0,
   "angle": 0,
   "strokeColor": "#495057",
