  {
   "id": "gyhJBCDMR2zl1Dz_XqSTp",
   "type": "text",
   "x": 1514,
   "y": 54,
   "width": 428.4,
   "height": 227.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 952278434,
   "version": 1,
   "versionNonce": 345308437,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1785777351988,
   "link": null,
   "locked": false,
   "index": "b0118",
   "text": "THE ONE THING TO TELL PEOPLE\n----------------------------\nTwo products differing ONLY in form or dose share\nthe centre number. That is deliberate -- the weight\nis study quality, so the difference is carried by\nthe ARCS, not by the number.\n\n    0.00 @ 0%    nobody tested your form\n   -0.70 @ 100%  your form WAS tested, and failed\n\nOpposite messages. They must never render the same,\nand a score published without its arcs is a false\nclaim: no ranked table, no lone \"glycinate = 52\".",
   "originalText": "THE ONE THING TO TELL PEOPLE\n----------------------------\nTwo products differing ONLY in form or dose share\nthe centre number. That is deliberate -- the weight\nis study quality, so the difference is carried by\nthe ARCS, not by the number.\n\n    0.00 @ 0%    nobody tested your form\n   -0.70 @ 100%  your form WAS tested, and failed\n\nOpposite messages. They must never render the same,\nand a score published without its arcs is a false\nclaim: no ranked table, no lone \"glycinate = 52\".",
   "fontSize": 14,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "pAjzvLEdKFgXWF73IezFT",
   "type": "rectangle",
   "x": 1500,
   "y": 325.5,
   "width": 560,
   "height": 308.0,
   "angle": 0,
