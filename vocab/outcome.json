{
  "vocab": "outcome",
  "version": "v1",
  "status": "PROVISIONAL — grown from S6 null-rationales, not designed up front. See vocab/README.md.",
  "policy": {
    "force_map_or_discard": "An extraction that cannot be mapped to exactly one id is DISCARDED, never approximated.",
    "kinds": {
      "clinical": "Something a person experiences or a clinician measures as the outcome itself.",
      "biomarker": "A measured surrogate. NEVER interchangeable with the clinical outcome it is hypothesised to influence.",
      "adverse_event": "Harm or tolerability. Never mapped to or from an efficacy outcome."
    },
    "prevention_vs_treatment": "Incidence and duration are separate ids. Confusing them inverts the sign of the finding.",
    "search_terms": "BROAD terms for RETRIEVAL. `includes` is precise because S6 maps INTO it; searching on those exact phrases returned 0 trials for sleep_onset. Recall and precision are different jobs."
  },
  "outcomes": [
    {
      "id": "sleep_onset",
      "label": "Time to fall asleep",
      "kind": "clinical",
      "definition": "Latency from lights-out to sleep onset.",
      "includes": [
        "sleep onset latency",
        "SOL",
        "time to fall asleep"
      ],
      "excludes": [
        "total sleep time",
        "wake after sleep onset"
      ],
      "search_terms": [
        "sleep onset",
        "sleep latency",
        "time to fall asleep",
        "insomnia"
      ]
    },
    {
      "id": "sleep_quality",
      "label": "Sleep quality",
      "kind": "clinical",
